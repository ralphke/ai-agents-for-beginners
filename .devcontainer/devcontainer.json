{
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli": "latest",
    "ghcr.io/devcontainers/features/node": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/dotnet": {
      "version": "10.0"
    }
  },
  "hostRequirements": {
    "cpus": 4
  },
  "onCreateCommand": "python3 -m pip install --upgrade pip setuptools wheel && python3 -m pip install -r requirements.txt",
  "updateContentCommand": "python3 -m pip install --upgrade pip setuptools wheel && python3 -m pip install -r requirements.txt",
  "postCreateCommand": "python3 -m ipykernel install --user --name python312 --display-name 'Python 3.12'",
  "mounts": [],
  "customizations": {
    "codespaces": {
      "openFiles": []
    },
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}
